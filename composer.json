{
    "name": "textandbytes/statamic-rubytext",
    "description": "Adds ruby text annotations to Statamic's Bard fieldtype.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Textandbytes\\StatamicRubytext\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Textandbytes\\StatamicRubytext\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Ruby Text",
            "description": "Adds a ruby text button to the Bard fieldtype in Statamic."
        },
        "laravel": {
            "providers": [
                "Textandbytes\\StatamicRubytext\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
